{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["/tmp"],
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(go mod:*)",
      "Bash(go run:*)",
      "Bash(go install:*)",
      "Bash(go env:*)",
      "Bash(go doc:*)",
      "Bash(task:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(goreleaser:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(rtk:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Read",
      "Read(~/.claude/skills/**)",
      "Read(~/.agents/skills/**)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:goreleaser.com)",
      "WebFetch(domain:taskfile.dev)",
      "WebSearch"
    ],
    "ask": [
      "Bash(rtk proxy:*)",
      "Bash(docker push:*)",
      "Bash(curl:*)",
      "Bash(sudo:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)"
    ]
  }
}
