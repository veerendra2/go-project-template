{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["/tmp"],
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(go mod:*)",
      "Bash(go run:*)",
      "Bash(go install:*)",
      "Bash(go env:*)",
      "Bash(go doc:*)",
      "Bash(task:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(goreleaser build:*)",
      "Bash(goreleaser check)",
      "Bash(goreleaser release --snapshot:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(rtk git:*)",
      "Bash(rtk gh:*)",
      "Bash(rtk json:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk rg:*)",
      "Bash(rtk find:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk tree:*)",
      "Bash(rtk diff:*)",
      "Bash(rtk wc:*)",
      "Bash(rtk docker:*)",
      "Bash(rtk test:*)",
      "Bash(rtk gain:*)",
      "Bash(rtk discover:*)",
      "Bash(rtk session:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Read(~/.claude/skills/**)",
      "Read(~/.agents/skills/**)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:goreleaser.com)",
      "WebFetch(domain:taskfile.dev)",
      "WebSearch"
    ],
    "ask": [
      "Bash(rtk proxy:*)",
      "Bash(docker push:*)",
      "Bash(curl:*)",
      "Bash(sudo:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)"
    ]
  }
}
